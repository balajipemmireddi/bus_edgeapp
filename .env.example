# Pi Configuration for Bus Edge App
# Copy this to .env and edit with your actual values

# Backend server (central cloud/Windows machine)
BACKEND_URL=http://192.168.1.72:8000

# Face processor on this Pi (dlib encoder runs here)
FACE_PROCESSOR_URL=http://192.168.1.85:8095

# Bus and enrollment configuration
BUS_ID=bus_14
ENROLLMENT_DASHBOARD_PORT=8090

# Optional: mDNS backend hostname (used if BACKEND_URL doesn't work)
BACKEND_HOSTNAME=LAPTOP-C4CD1RI3
