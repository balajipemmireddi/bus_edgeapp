# Pi Configuration for Bus Edge App
# ===================================
# Copy this to .env and edit with YOUR actual IP addresses

# Windows/Backend server IP (where backend API runs on port 8000)
# Find it on Windows: ipconfig
BACKEND_URL=http://192.168.1.72:8000

# Face processor on THIS Pi (encoding runs here, not on Windows)
# This Pi's IP: 192.168.1.85
FACE_PROCESSOR_URL=http://192.168.1.85:8095

# Bus configuration
BUS_ID=bus_14
ENROLLMENT_DASHBOARD_PORT=8090

# NETWORK TOPOLOGY:
#   Windows PC (192.168.1.72)
#       ↓ (backend API runs here)
#   Raspberry Pi (192.168.1.85)  
#       ↓ (face_processor runs here)
#   dlib encoder (heavy lifting on Pi)
