# Pi Configuration for Bus Edge App
# ===================================
# Copy this to .env and edit with YOUR actual IP addresses

# Windows/Backend server IP (where backend API runs on port 8000)
# Find it on Windows: ipconfig
BACKEND_URL=http://192.168.1.72:8000

# Face processor on THIS Pi (encoding runs here, not on Windows)
# This Pi's IP: 192.168.1.85
FACE_PROCESSOR_URL=http://192.168.1.85:8095

# Device code - identifies this Pi to the backend
# NOT a database ID - just a device name
# Must be registered in backend: devices.device_code
# Backend uses this to look up: devices.device_code → devices.bus_id → roster
# Format examples: bus_14, pi_01, device_001
DEVICE_CODE=bus_14

ENROLLMENT_DASHBOARD_PORT=8090

# NETWORK TOPOLOGY:
#   Windows PC (192.168.1.72)
#       ↓ (backend API runs here, :8000)
#   Raspberry Pi (192.168.1.85)
#       ├── face_processor (runs here, :8095)
#       └── state machine (uses DEVICE_CODE to identify self)
#
# IMPORTANT:
#   - DEVICE_CODE is NOT a database ID
#   - Backend must have devices.device_code registered
#   - Pi requests: /api/device/{DEVICE_CODE}/roster
#   - Backend looks up: device_code → bus_id → students
